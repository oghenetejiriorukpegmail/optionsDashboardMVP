# Alpha Vantage API Key for market data
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_key_here

# Polygon.io API Key for stock quotes and historical data
POLYGON_API_KEY=your_polygon_key_here

# Twelve Data API Key for additional market data
TWELVE_DATA_API_KEY=your_twelve_data_key_here

# Server port (optional, defaults to 5000)
PORT=5000

# IBKR Configuration (optional, for Interactive Brokers integration)
IBKR_GATEWAY_URL=https://localhost:5000
IBKR_ACCOUNT_ID=your_ibkr_account_id

# For local IBKR development only - DO NOT use in production!
# NODE_TLS_REJECT_UNAUTHORIZED=0

# Options Data Provider Configuration
# Available providers: yahoo, alphavantage, tradier, marketdata
# Default: yahoo (no API key required)
OPTIONS_DATA_PROVIDER=yahoo

# Provider-specific API Keys (optional)
# TRADIER_API_KEY=your_tradier_api_key
# MARKETDATA_APP_API_KEY=your_marketdata_api_key

# Cache configuration (optional)
# OPTIONS_CACHE_TIMEOUT_MINUTES=15
# OPTIONS_RATE_LIMIT_DELAY_MS=200