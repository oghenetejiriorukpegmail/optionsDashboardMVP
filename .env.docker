# Docker Environment Configuration
# Copy this to .env and update with your actual API keys

# Application Configuration
NODE_ENV=production
PORT=4000

# API Configuration - REPLACE WITH YOUR ACTUAL API KEYS
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_api_key_here
POLYGON_API_KEY=your_polygon_api_key_here
TWELVE_DATA_API_KEY=your_twelve_data_api_key_here
MARKETDATA_APP_API_KEY1=your_marketdata_api_key_1_here
MARKETDATA_APP_API_KEY2=your_marketdata_api_key_2_here

# Database Configuration
DATABASE_URL=/app/data/options_scanner.db

# IBKR Configuration
IBKR_GATEWAY_URL=https://localhost:5000
IBKR_ACCOUNT_ID=your_ibkr_account_id_here

# Disable SSL verification for local IBKR development only
# NODE_TLS_REJECT_UNAUTHORIZED=0